# Protocol LP Automation — Environment
# Copy to .env and fill in values

RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
KEYPAIR_PATH=/root/.keys/lp-keypair.json

# Pool (default: CRANK/SOL)
# POOL_ADDRESS=9R9gcCqPazHZt217aqh3fYDNBGnqENcupWYd97LYiUDp

# Re-entry config
# REENTRY_BIN_COUNT=70
# REENTRY_STRATEGY=BidAsk
# MIN_REENTRY_LAMPORTS=2000000000
# SOL_RESERVE_LAMPORTS=50000000

# Harvest threshold
# MIN_HARVEST_LAMPORTS=10000000

# Polling
# POLL_INTERVAL_MS=30000
# POLL_FAST_MS=5000

# Monitoring
# HEALTH_PORT=8081
# DISCORD_WEBHOOK_URL=

# Safety — set to false when ready to go live
DRY_RUN=true
